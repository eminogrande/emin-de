---
// One story teaser. variant: lead | grid | row. One link per card (the
// title); the whole card is clickable through a stretched ::after.
import Cover from './Cover.astro';
import Badge from './Badge.astro';
import { longDate, readTime, categoryLabel } from '../lib/magazine.mjs';
import { categoryPath } from '../lib/paths.mjs';
const { post, variant = 'grid', eager = false, level = 3 } = Astro.props;
const H = `h${level}`;
const sizes = variant === 'lead' ? '(max-width: 700px) calc(100vw - 2.5rem), 46rem' : variant === 'row' ? '(max-width: 700px) 7rem, 12rem' : '(max-width: 700px) calc(100vw - 2.5rem), (max-width: 1000px) 45vw, 25rem';
---
{variant === 'lead' ? (
	<article class="story lead" lang={post.lang}>
		<Cover post={post} sizes={sizes} eager={eager} />
		<div>
			<a class="kicker" href={categoryPath(post.lang, post.category)}>{categoryLabel(post)}</a>
			<H><a class="title-link" href={post.path}>{post.title}</a></H>
			<p class="dek">{post.description}</p>
			<div class="meta-row"><p class="meta"><time datetime={post.date}>{longDate(post.lang, post.date)}</time><span>{readTime(post)}</span></p><Badge post={post} /></div>
		</div>
	</article>
) : variant === 'row' ? (
	<li class="story" lang={post.lang}>
		<div>
			<a class="kicker" href={categoryPath(post.lang, post.category)}>{categoryLabel(post)}</a>
			<H><a class="title-link" href={post.path}>{post.title}</a></H>
			<p class="dek">{post.description}</p>
			<p class="meta"><time datetime={post.date}>{longDate(post.lang, post.date)}</time><span>{readTime(post)}</span></p>
		</div>
		<Cover post={post} sizes={sizes} />
	</li>
) : (
	<li class="story" lang={post.lang}>
		<Cover post={post} sizes={sizes} eager={eager} />
		<a class="kicker" href={categoryPath(post.lang, post.category)}>{categoryLabel(post)}</a>
		<H><a class="title-link" href={post.path}>{post.title}</a></H>
		<p class="dek">{post.description}</p>
		<div class="meta-row"><p class="meta"><time datetime={post.date}>{longDate(post.lang, post.date)}</time><span>{readTime(post)}</span></p><Badge post={post} /></div>
	</li>
)}
