---
// Renders one article from the articles module. The HTML and the Markdown mirror
// are both generated from this same data, so the two cannot drift.
import { AUTHOR_NAME } from '../lib/site.mjs';
const { article } = Astro.props;
const published = new Date(article.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const updated = new Date(article.modifiedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const showUpdated = article.modifiedAt !== article.publishedAt;
---

<article>
	<h1>{article.title}</h1>

	<div class="tldr">
		<strong>TL;DR</strong>
		<p>{article.tldr}</p>
	</div>

	<div class="byline">
		<span>{AUTHOR_NAME}</span>
		<span class="sep">/</span>
		<span>Published <time datetime={article.publishedAt}>{published}</time></span>
		{showUpdated && (
			<>
				<span class="sep">/</span>
				<span>Updated <time datetime={article.modifiedAt}>{updated}</time></span>
			</>
		)}
		<span class="sep">/</span>
		<span>{article.readingTimeMinutes} minute read</span>
		<span class="sep">/</span>
		<span>{article.wordCount} words</span>
		<button class="copy-url" type="button" data-copy-url>Copy URL</button>
	</div>

	<ul class="pill-row">
		{article.topics.map((topic) => <li><span class="pill">{topic}</span></li>)}
	</ul>

	{article.sections.map((section) => (
		<section id={section.id}>
			<h2>{section.heading}</h2>
			{(section.paragraphs || []).map((paragraph) => <p>{paragraph}</p>)}

			{section.steps && (
				<ol>
					{section.steps.map((step) => <li>{step}</li>)}
				</ol>
			)}

			{section.table && (
				<div class="table-wrap">
					<table>
						<caption>{section.table.caption}</caption>
						<thead>
							<tr>{section.table.columns.map((column) => <th scope="col">{column}</th>)}</tr>
						</thead>
						<tbody>
							{section.table.rows.map((row) => (
								<tr>
									{row.map((cell, index) => (index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)}

			{section.basically && <p class="basically"><b>Basically,</b> {section.basically}</p>}
		</section>
	))}

	{article.sources?.length > 0 && (
		<section id="sources" class="sources">
			<h2>Sources</h2>
			<ul>
				{article.sources.map((source) => (
					<li>
						<a href={source.url} rel="noopener">{source.title}</a>
						{source.note && <span> {source.note}</span>}
					</li>
				))}
			</ul>
		</section>
	)}

	<p><a href={`${Astro.url.pathname.replace(/\/$/, '')}/index.md`}>Read this article as Markdown</a></p>
</article>

<script>
	// Copy URL is the one piece of JS on an article page. Keyboard accessible by
	// virtue of being a real button; no library, no analytics.
	document.querySelector('[data-copy-url]')?.addEventListener('click', async (event) => {
		const button = event.currentTarget;
		try {
			await navigator.clipboard.writeText(window.location.href);
			const original = button.textContent;
			button.textContent = 'Copied';
			setTimeout(() => { button.textContent = original; }, 1600);
		} catch {
			button.textContent = window.location.href;
		}
	});
</script>
