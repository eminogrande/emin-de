---
// The front page for one language, in the article's rhythm: a big display
// hero, the lead story with its cover, then Solarized bands (latest, one per
// theme, more) with clean lists and big titles.
import Story from './Story.astro';
import config from '../../site.config.mjs';
import { postsIn } from '../lib/corpus.mjs';
import { homeSections, longDate } from '../lib/magazine.mjs';
import { label, tr, postsIndexPath, archivePath, categoryPath, join } from '../lib/paths.mjs';
const { lang } = Astro.props;
const list = postsIn(lang);
const { lead, grid, themes, more } = homeSections(list, lang);
const pub = config.publisher;
---
<header class="home-hero">
	<div class="container home-hero__inner">
		<p class="eyebrow">{pub.name} · {label(pub.role, lang, 'role')}</p>
		<h1 id="hero-title" class="display home-hero__title">{label(config.hero, lang, 'hero')}</h1>
		<p class="home-hero__lede">{tr(lang, 'hero_lede', { name: pub.name, pub: pub.publication.name })} <a href="/about">{tr(lang, 'More about me')}</a>.</p>
	</div>
</header>

{lead && (
	<section class="band band--alt" aria-label={tr(lang, 'Lead story')}>
		<div class="container"><Story post={lead} variant="lead" eager level={2} /></div>
	</section>
)}

{grid.length > 0 && (
	<section class="band" aria-labelledby="latest">
		<div class="container">
			<div class="band-head"><h2 id="latest">{tr(lang, 'Latest')}</h2><a href={postsIndexPath(lang)}>{tr(lang, 'All posts')}</a></div>
			<ul class="rows">{grid.map((post) => <Story post={post} variant="row" />)}</ul>
		</div>
	</section>
)}

{themes.map((theme, i) => (
	<section class:list={['band', { 'band--alt': i % 2 === 0 }]} aria-labelledby={`t-${theme.id}`}>
		<div class="container">
			<div class="band-head"><h2 id={`t-${theme.id}`}>{theme.title}</h2><a href={categoryPath(lang, theme.categories[0])}>{tr(lang, 'More')}<span class="sr"> {theme.title}</span></a></div>
			<ul class="rows">{theme.posts.map((post) => <Story post={post} variant="row" />)}</ul>
		</div>
	</section>
))}

{more.length > 0 && (
	<section class:list={['band', { 'band--alt': themes.length % 2 === 0 }]} aria-labelledby="more">
		<div class="container">
			<div class="band-head"><h2 id="more">{tr(lang, 'More')}</h2><a href={archivePath(lang)}>{tr(lang, 'Archive')}</a></div>
			<ul class="more">{more.map((post) => <li><a href={post.path}>{post.title}</a><span class="meta"><time datetime={post.date}>{longDate(lang, post.date)}</time></span></li>)}</ul>
			<a class="all-link" href={postsIndexPath(lang)}>{tr(lang, 'All {n} posts', { n: list.length })} →</a>
		</div>
	</section>
)}
