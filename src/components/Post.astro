---
// One post. HTML and the Markdown mirror come from the same parsed sections,
// so they cannot drift. Magazine layout: kicker, giant serif headline, dek,
// byline with date + reading time + provenance badge, cover, serif body.
import config from '../../site.config.mjs';
import Badge from './Badge.astro';
import { t, label, categoryPath, formatPath, authorPath } from '../lib/paths.mjs';
import { youtubeId } from '../lib/surfaces.mjs';
import { displayAuthor, authorLabel } from '../lib/content-build-shared.mjs';
import { longDate, readTime, firstPublishedLine } from '../lib/magazine.mjs';
const { post, alternates = [] } = Astro.props;
const author = config.authors[post.author];
const isAi = author.type === 'ai_editorial';
const supervisor = isAi ? config.authors[author.supervisor] : null;
const vid = post.video ? youtubeId(post.video.url) : null;
const others = alternates.filter((a) => a.lang !== post.lang);
const de = post.lang === 'de';
const first = firstPublishedLine(post);
const showCover = post.cover && !post.cover.generated && !post.cover.inBody;
const showDek = post.description && !post.dekRepeatsBody;
const firstSection = post.html[0];
const dropcap = firstSection && !firstSection.heading && /^<p>[A-Za-zÄÖÜäöü]/.test(firstSection.html.trim());
---

<article lang={post.lang}>
	<header class="post-head wrap">
		<a class="kicker" href={categoryPath(post.lang, post.category)}>{label(config.categories[post.category], post.lang)}</a>
		<h1 class="post-title">{post.title}</h1>
		{showDek && <p class="dek post-dek">{post.description}</p>}
		<div class="byline">
			<p class="meta">
				<span>{t(post.lang, 'by')} {author.type === 'guest' ? displayAuthor(post) : <a href={authorPath(post.lang, post.author)}>{author.name}</a>}{isAi && supervisor && ` (${de ? 'beaufsichtigt von' : 'supervised by'} ${supervisor.name})`}</span>
				<time datetime={post.date}>{longDate(post.lang, post.date)}</time>
				<span>{readTime(post)}</span>
			</p>
			<Badge post={post} />
		</div>
		{author.type === 'guest' && <p class="ai-label" role="note"><strong>{authorLabel(post)}.</strong> {de ? 'Text von' : 'Text by'} {post.originalAuthor}{de ? ', hier archiviert.' : ', archived here.'}</p>}
	</header>

	{showCover && (
		<figure class="post-cover wrap">
			<img src={post.cover.src} srcset={post.cover.srcset} sizes="(max-width: 1100px) 100vw, 64rem" width={post.cover.width} height={post.cover.height} alt="" fetchpriority="high" decoding="sync" />
		</figure>
	)}

	<div class="wrap">
		{post.tldr.length > 0 && (
			<div class="tldr">
				<strong>{t(post.lang, 'tldr')}</strong>
				<ul>{post.tldr.map((item) => <li>{item}</li>)}</ul>
			</div>
		)}

		<div class:list={['prose', { dropcap }]}>
			{vid && <p class="video-link"><a href={post.video.url}>{t(post.lang, 'watch')}: {post.video.title || post.title}</a></p>}
			{post.html.map((section) => (
				<section id={section.id || undefined}>
					{section.heading && <h2>{section.heading}</h2>}
					<Fragment set:html={section.html} />
					{section.id && post.basically[section.id] && <p class="basically"><b>{t(post.lang, 'basically')}</b> {post.basically[section.id]}</p>}
				</section>
			))}
		</div>

		<footer class="post-foot">
			{post.sourceLinks.length > 0 && (
				<section id="sources" class="sources">
					<h2>{t(post.lang, 'sources')}</h2>
					<ul>{post.sourceLinks.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a>{s.note && <span> {s.note}</span>}</li>)}</ul>
				</section>
			)}
			{first && <p class="first-published">{first.prefix} <a href={post.originalUrl} rel="noopener">{first.site}</a>{first.suffix}</p>}
			{post.thirdPartySummary && <p class="provenance">{de ? 'Zusammenfassung fremden Materials; Quelle im Original verlinkt.' : 'Summary of third-party material; see the original for the source.'}</p>}
			<p class="provenance">{isAi && <><a href={authorPath(post.lang, post.author)}>{authorLabel(post)}</a>. </>}{t(post.lang, 'provenance')[post.provenance] || post.provenance}. {t(post.lang, 'aiAssisted')[String(post.aiAssisted)]}. {t(post.lang, 'reviewed')[String(post.reviewedByHuman)]}. <a href={formatPath(post.lang, post.format)}>{label(config.formats[post.format], post.lang)}</a>.</p>
			{others.length > 0 && <p>{t(post.lang, 'alsoIn')}: {others.map((a) => <a href={a.path} hreflang={a.lang} lang={a.lang}>{a.lang.toUpperCase()} </a>)}</p>}
			<p><a href={post.markdownPath}>{t(post.lang, 'readMarkdown')}</a> · <a href={`${config.repo}/blob/main/${post.file}`}>GitHub</a></p>
		</footer>
	</div>
</article>
