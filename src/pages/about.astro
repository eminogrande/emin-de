---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import LiteYouTubeScript from '../components/LiteYouTubeScript.astro';
import { AUTHOR_NAME, SITE } from '../lib/site.mjs';
import { renderHtml } from '../lib/markdown.mjs';
import { aboutMarkdown } from '../content/about.mjs';
const pub = SITE.publisher;
// The body is Markdown in src/content/about.mjs, shared with /about/index.md.
const html = renderHtml(aboutMarkdown());
---

<Base
	title="About Emin Mahrt | emin.de"
	description="Emin Henri Mahrt builds Bitcoin self-custody and agent-payment infrastructure. His work, writing, talks and selected sources."
	path="/about"
	markdownPath="/about/index.md"
>
	<div class="about-top">
		<div>
			<p class="kicker">{pub.role.en}</p>
			<h1>About</h1>
		</div>
		<Portrait name={AUTHOR_NAME} eager />
	</div>

	<div class="prose">
		<Fragment set:html={html} />
	</div>

	<LiteYouTubeScript />
</Base>
