---
import Base from '../layouts/Base.astro';
import { renderHtml } from '../lib/markdown.mjs';
import { markdownForPath } from '../content/pages.mjs';
import { SITE } from '../lib/site.mjs';
// Generated from the same Markdown as /privacy/index.md, so the policy always
// matches the analytics switches in site.config.mjs.
const md = markdownForPath('/privacy');
const html = renderHtml(md.replace(/^# .*\n/, ''));
const ga = SITE.analytics.ga4;
---

<Base
	title={`Privacy | ${SITE.name}`}
	description="What this site collects: no cookies, no advertising pixels, no account system. Analytics, when enabled, runs cookieless; Google Analytics only after explicit opt-in."
	path="/privacy"
	markdownPath="/privacy/index.md"
>
	<h1>Privacy</h1>
	<Fragment set:html={html} />
	{ga.enabled && ga.measurementId && (
		<p>
			<button type="button" data-consent="granted">Allow Google Analytics</button>
			<button type="button" data-consent="denied">Do not allow</button>
		</p>
		<script is:inline set:html={`document.querySelectorAll('[data-consent]').forEach(function(b){b.addEventListener('click',function(){localStorage.setItem('analytics-consent',b.dataset.consent);b.textContent+=' \u2713';});});`} />
	)}
</Base>
