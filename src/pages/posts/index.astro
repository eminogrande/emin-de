---
import Base from '../../layouts/Base.astro';
import { articles, articlePath, allTopics } from '../../content/articles.mjs';
import { absoluteUrl } from '../../lib/site.mjs';

const latest = [...articles].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
const listSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Posts',
	url: absoluteUrl('/posts'),
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: latest.length,
		itemListElement: latest.map((article, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: absoluteUrl(articlePath(article.slug)),
			name: article.title,
		})),
	},
};
---

<Base
	title="All posts | emin.de"
	description="Every long-form article on emin.de, newest first. Bitcoin self-custody, passkeys, MuSig2, x402 agent payments, MCP and agent-readiness engineering."
	path="/posts"
	structuredData={listSchema}
	markdownPath="/posts/index.md"
>
	<h1>Posts</h1>
	<p class="lede">Long-form only. Each article has a Markdown mirror and is included in the public API and the MCP server.</p>

	<ul class="pill-row">
		{allTopics.map((topic) => <li><span class="pill">{topic}</span></li>)}
	</ul>

	<ul class="card-list">
		{latest.map((article) => (
			<li>
				<a class="card" href={articlePath(article.slug)}>
					<h2>{article.title}</h2>
					<p>{article.description}</p>
					<span class="meta">{article.publishedAt} / {article.readingTimeMinutes} min / {article.wordCount} words</span>
				</a>
			</li>
		))}
	</ul>
</Base>
