{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "emin.de photo captions",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "photos": {
      "type": "object",
      "description": "Keyed by file name in public/photos/ (e.g. \"zanzibar-2024.jpg\"). Order here is the order on /photos.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "alt": {
            "type": "object",
            "description": "What the photo shows, per language. Required for accessibility.",
            "properties": {
              "en": {
                "type": "string"
              },
              "de": {
                "type": "string"
              }
            }
          },
          "caption": {
            "type": "object",
            "description": "Visible caption per language.",
            "properties": {
              "en": {
                "type": "string"
              },
              "de": {
                "type": "string"
              }
            }
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "place": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean",
            "description": "Leave the file in the folder but do not show it on /photos."
          }
        }
      }
    }
  },
  "required": [
    "photos"
  ],
  "additionalProperties": false
}
