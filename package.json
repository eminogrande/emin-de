{
  "name": "emin-de",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Markdown-first, multi-language, agent-ready blog engine (template). First site: emin.de.",
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "check": "node scripts/generate-content.mjs && python3 plugins/check_draft.py content/posts/en/2026/what-agent-ready-actually-means.md",
    "new": "node scripts/new-post.mjs",
    "prebuild": "node scripts/generate-content.mjs",
    "build": "astro build",
    "build:test": "CONTENT_DIRS=content,tests/fixtures/sample,tests/fixtures/i18n node scripts/generate-content.mjs && astro build",
    "dev": "node scripts/generate-content.mjs && astro dev",
    "start": "node server.mjs",
    "preview": "node server.mjs",
    "worker:dev": "npx wrangler@latest dev",
    "test": "node --test tests/*.test.mjs",
    "traffic": "node plugins/traffic-report.mjs",
    "indexnow": "node plugins/indexnow.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "import:staging": "node scripts/import-staging.mjs",
    "migrate:canonical": "node scripts/migrate-canonical.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^6.1.8",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "lighthouse": "^13.3.0",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=22"
  }
}
